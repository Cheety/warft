# One of the four roles from SP-A02-1. Which one a node takes is the boot value `role`, read from
# a credential by workpod-role-generator; the image is the same artifact either way (AB-A02-1).
#
# `knowledge` carries the knowledge layer of panel G — the index a job is given context from, and
# the write-back path the finished job leaves its judgement candidates on. It is cut by the locality
# group (E-03), not by the tenant.
#
# Its first process arrives with stage 4 (G-01, E-09). The A-04 sequence up to the selftest
# already holds, so a knowledge node earns its boot the way every other role does.

[Unit]
Description=Workpod node role: knowledge
Documentation=https://github.com/Cheety/warft/blob/main/01-specification.md
Wants=workpod-knowledge.slice
Wants=workpod-disk.service workpod-selftest.service
